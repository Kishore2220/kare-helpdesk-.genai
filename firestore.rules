rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // One profile per user. Students can only create their own profile as 'student'.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly(['register_number', 'full_name', 'role', 'created_at']);
      allow update, delete: if isAdmin();
    }

    // Complaints: students see and create their own, admins see all and change status.
    match /complaints/{id} {
      allow read: if signedIn() && (resource.data.student_id == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Counter that gives complaint numbers KARE-1024, KARE-1025 ...
    match /counters/complaints {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.last == 1024;
      allow update: if signedIn() && request.resource.data.last == resource.data.last + 1;
    }

    // Information pages: everyone signed in reads, only admins edit.
    match /programs/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /info_items/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
